  MIGRATOR_DATABASE_URL: "postgresql://encryption_migrator:migrator-password@postgres.example.org:5432/encryption?schema=encryption"
  SENTRY_DSN: "https://11111111111111111111111111111111@glitchtip.example.org/1"
