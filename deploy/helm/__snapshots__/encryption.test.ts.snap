"---
# Source: encryption-chart/templates/networkpolicy.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: enc-encryption
  namespace: "encryption"
  labels:
    helm.sh/chart: encryption-chart-0.0.0-dev
    app.kubernetes.io/name: encryption
    app.kubernetes.io/instance: enc
    app.kubernetes.io/version: "1.2.3"
    app.kubernetes.io/managed-by: Helm
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: encryption
      app.kubernetes.io/instance: enc
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - ports:
        - port: 7200
          protocol: TCP
      from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ingress-nginx
  egress:
    # Name resolution, wherever the cluster DNS lives.
    - ports:
        - port: 53
          protocol: UDP
        - port: 53
          protocol: TCP
    - ports:
      - port: 5432
        protocol: TCP
      to:
      - ipBlock:
          cidr: 10.0.0.0/8
