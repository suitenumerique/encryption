{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "suite-stack values",
  "description": "Only the chart's own keys are described: each subchart validates its block (encryption strictly, the others not at all).",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "shared": { "type": "object" },
    "encryption": { "type": "object" },
    "docs": { "type": "object" },
    "drive": { "type": "object" },
    "global": { "type": "object" },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres", "minio", "keycloak", "encryption", "job"],
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["databases"],
          "properties": {
            "databases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
          }
        },
        "minio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["buckets"],
          "properties": {
            "buckets": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" } },
            "versioning": { "type": "boolean" }
          }
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clients", "users", "notice"],
          "properties": {
            "notice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["header", "termsTitle", "terms"],
              "properties": {
                "header": { "type": "string", "minLength": 1 },
                "termsTitle": { "type": "string", "minLength": 1 },
                "terms": { "type": "string", "minLength": 1 }
              }
            },
            "clients": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["clientId", "redirectUris", "webOrigins"],
                "properties": {
                  "clientId": { "type": "string", "minLength": 1 },
                  "public": { "type": "boolean" },
                  "secret": { "type": "string", "pattern": "^[^'\"]*$" },
                  "redirectUris": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } },
                  "webOrigins": { "type": "array", "items": { "type": "string", "pattern": "^https://[^/]+$" } }
                }
              }
            },
            "users": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["username", "email", "firstName", "lastName", "password"],
                "properties": {
                  "username": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
                  "email": { "type": "string", "pattern": "^[^'\"@\\s]+@[^'\"@\\s]+$" },
                  "firstName": { "type": "string", "pattern": "^[^'\"]+$" },
                  "lastName": { "type": "string", "pattern": "^[^'\"]+$" },
                  "password": { "type": "string", "minLength": 1, "pattern": "^[^'\"]+$" }
                }
              }
            }
          }
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database", "migratorPassword", "runtimePassword"],
          "properties": {
            "database": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "migratorPassword": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
            "runtimePassword": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" }
          }
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backoffLimit": { "type": "integer", "minimum": 0 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "onlyoffice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "jwtSecret"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "host": { "type": "string" },
        "jwtSecret": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "secretName": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "mailpit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "host": { "type": "string" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "secretName": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
