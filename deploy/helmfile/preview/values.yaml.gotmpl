{{- $f := .Values.feature | toString -}}
{{- $d := .Values.domain -}}
{{- $ns := .Namespace | default (printf "preview-%s" $f) -}}
{{- $docs := printf "%s-docs.%s" $f $d -}}
{{- $drive := printf "%s-drive.%s" $f $d -}}
{{- $interface := printf "%s-encryption.%s" $f $d -}}
{{- $vault := printf "data.%s-encryption.%s" $f $d -}}
{{- $auth := printf "%s-auth.%s" $f $d -}}
{{- $s3 := printf "%s-s3.%s" $f $d -}}
{{- $issuer := printf "https://%s/realms/suite" $auth -}}
{{- $minio := printf "minio.%s.svc.cluster.local" $ns -}}
{{- $i := .Values.images -}}
# Rendered by helmfile on top of the chart's values.yaml: only what carries a hostname, the
# namespace or an image is here, every other value stays the chart's default. Lists are
# replaced whole, not merged, so the ones that carry a hostname are given in full.
shared:
  minio:
    ingress:
      hostname: {{ $s3 }}
      annotations:
        cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
    consoleIngress:
      hostname: {{ $f }}-s3-console.{{ $d }}
      annotations:
        cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  keycloak:
    hostname: {{ $auth }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

bootstrap:
  keycloak:
    clients:
      - clientId: docs
        secret: ThisIsAnExampleKeyForDevPurposeOnly
        redirectUris:
          - https://{{ $docs }}/*
        webOrigins:
          - https://{{ $docs }}
      - clientId: drive
        secret: ThisIsAnExampleKeyForDevPurposeOnly
        redirectUris:
          - https://{{ $drive }}/*
        webOrigins:
          - https://{{ $drive }}
      - clientId: encryption
        public: true
        redirectUris:
          - https://{{ $interface }}/auth/callback
        webOrigins:
          - https://{{ $interface }}

mailpit:
  host: {{ $f }}-mail.{{ $d }}
  ingress:
    className: {{ .Values.ingressClassName }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

onlyoffice:
  host: {{ $f }}-office.{{ $d }}
  ingress:
    className: {{ .Values.ingressClassName }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

encryption:
  image:
    repository: {{ $i.encryption.repository }}
    tag: {{ $i.encryption.tag | quote }}
  hosts:
    vault: {{ $vault }}
    interface: {{ $interface }}
  config:
    allowedFrameAncestors:
      - https://{{ $docs }}
      - https://{{ $drive }}
    oidc:
      issuer: {{ $issuer }}
      jwksUrl: {{ $issuer }}/protocol/openid-connect/certs
    mailer:
      senderAddress: noreply@{{ $d }}
    emailProductUrl: https://{{ $docs }}
  ingress:
    className: {{ .Values.ingressClassName }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

docs:
  image:
    repository: {{ $i.docs.repository }}
    tag: {{ $i.docs.tag | quote }}
  backend:
    envVars:
      DJANGO_ALLOWED_HOSTS: {{ $docs }}
      DJANGO_CSRF_TRUSTED_ORIGINS: https://{{ $docs }}
      DJANGO_EMAIL_LOGO_IMG: https://{{ $docs }}/assets/logo-suite-numerique.png
      DJANGO_EMAIL_URL_APP: https://{{ $docs }}
      OIDC_OP_JWKS_ENDPOINT: {{ $issuer }}/protocol/openid-connect/certs
      OIDC_OP_AUTHORIZATION_ENDPOINT: {{ $issuer }}/protocol/openid-connect/auth
      OIDC_OP_TOKEN_ENDPOINT: {{ $issuer }}/protocol/openid-connect/token
      OIDC_OP_USER_ENDPOINT: {{ $issuer }}/protocol/openid-connect/userinfo
      OIDC_OP_LOGOUT_ENDPOINT: {{ $issuer }}/protocol/openid-connect/logout
      OIDC_REDIRECT_ALLOWED_HOSTS: {{ $docs }}
      LOGIN_REDIRECT_URL: https://{{ $docs }}
      LOGIN_REDIRECT_URL_FAILURE: https://{{ $docs }}
      LOGOUT_REDIRECT_URL: https://{{ $docs }}
      ENCRYPTION_VAULT_URL: https://{{ $vault }}
      ENCRYPTION_INTERFACE_URL: https://{{ $interface }}
  frontend:
    image:
      repository: {{ $i.docsFrontend.repository }}
      tag: {{ $i.docsFrontend.tag | quote }}
    envVars:
      NEXT_PUBLIC_API_ORIGIN: https://{{ $docs }}
  yProvider:
    image:
      repository: {{ $i.docsYProvider.repository }}
      tag: {{ $i.docsYProvider.tag | quote }}
    envVars:
      COLLABORATION_BACKEND_BASE_URL: https://{{ $docs }}
      COLLABORATION_SERVER_ORIGIN: https://{{ $docs }}
  ingress:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  ingressCollaborationWS:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
  ingressCollaborationApi:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
  ingressAdmin:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
  ingressMedia:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
    annotations:
      nginx.ingress.kubernetes.io/auth-url: https://{{ $docs }}/api/v1.0/documents/media-auth/
      nginx.ingress.kubernetes.io/upstream-vhost: {{ $minio }}:9000
  serviceMedia:
    host: {{ $minio }}

drive:
  image:
    repository: {{ $i.drive.repository }}
    tag: {{ $i.drive.tag | quote }}
  backend:
    envVars:
      DJANGO_ALLOWED_HOSTS: {{ $drive }}
      DJANGO_CSRF_TRUSTED_ORIGINS: https://{{ $drive }}
      DJANGO_EMAIL_LOGO_IMG: https://{{ $drive }}/assets/logo-suite-numerique.png
      OIDC_OP_JWKS_ENDPOINT: {{ $issuer }}/protocol/openid-connect/certs
      OIDC_OP_AUTHORIZATION_ENDPOINT: {{ $issuer }}/protocol/openid-connect/auth
      OIDC_OP_TOKEN_ENDPOINT: {{ $issuer }}/protocol/openid-connect/token
      OIDC_OP_USER_ENDPOINT: {{ $issuer }}/protocol/openid-connect/userinfo
      OIDC_OP_LOGOUT_ENDPOINT: {{ $issuer }}/protocol/openid-connect/logout
      LOGIN_REDIRECT_URL: https://{{ $drive }}
      LOGIN_REDIRECT_URL_FAILURE: https://{{ $drive }}
      LOGOUT_REDIRECT_URL: https://{{ $drive }}
      AWS_S3_ENDPOINT_URL: https://{{ $s3 }}
      MEDIA_BASE_URL: https://{{ $drive }}
      ENCRYPTION_VAULT_URL: https://{{ $vault }}
      ENCRYPTION_INTERFACE_URL: https://{{ $interface }}
      WOPI_SRC_BASE_URL: https://{{ $drive }}
  frontend:
    image:
      repository: {{ $i.driveFrontend.repository }}
      tag: {{ $i.driveFrontend.tag | quote }}
    envVars:
      NEXT_PUBLIC_API_ORIGIN: https://{{ $drive }}
  ingress:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  ingressAdmin:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
  ingressMedia:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
    annotations:
      nginx.ingress.kubernetes.io/auth-url: https://{{ $drive }}/api/v1.0/items/media-auth/
      nginx.ingress.kubernetes.io/upstream-vhost: {{ $minio }}:9000
  ingressMediaPreview:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
    annotations:
      nginx.ingress.kubernetes.io/auth-url: https://{{ $drive }}/api/v1.0/items/media-auth/
      nginx.ingress.kubernetes.io/upstream-vhost: {{ $minio }}:9000
  serviceMedia:
    host: {{ $minio }}
