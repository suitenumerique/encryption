{{- $f := .Values.feature | toString -}}
{{- $d := .Values.domain -}}
{{- $ns := .Namespace | default (printf "preview-%s" $f) -}}
{{- $docs := printf "%s-docs.%s" $f $d -}}
{{- $drive := printf "%s-drive.%s" $f $d -}}
{{- $interface := printf "%s-encryption.%s" $f $d -}}
{{- $vault := printf "data.%s-encryption.%s" $f $d -}}
{{- $accounts := printf "%s-accounts.%s" $f $d -}}
{{- $auth := printf "%s-auth.%s" $f $d -}}
{{- $s3 := printf "%s-s3.%s" $f $d -}}
{{- $keycloakIssuer := printf "https://%s/realms/suite" $auth -}}
{{- $issuer := printf "https://%s/api/v1.0/o" $accounts -}}
{{- $minio := printf "minio.%s.svc.cluster.local" $ns -}}
{{- $i := .Values.images -}}
{{- /* One tag per product for all its images, given as a state value: by the deployment
from a pull request label (`docs:pr-2694` becomes docsImageTag=pr-2694), or by hand.
Unset, each image keeps its own tag from the helmfile, `main` unless overridden. */ -}}
{{- $docsTag := .Values | get "docsImageTag" "" | toString -}}
{{- $driveTag := .Values | get "driveImageTag" "" | toString -}}
{{- $accountsTag := .Values | get "accountsImageTag" "" | toString -}}
# Rendered by helmfile on top of the chart's values.yaml: only what carries a hostname, the
# namespace or an image is here, every other value stays the chart's default. Lists are
# replaced whole, not merged, so the ones that carry a hostname are given in full.
shared:
  minio:
    ingress:
      hostname: {{ $s3 }}
      annotations:
        cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
    consoleIngress:
      hostname: {{ $f }}-s3-console.{{ $d }}
      annotations:
        cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  keycloak:
    hostname: {{ $auth }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

bootstrap:
  keycloak:
    clients:
      - clientId: accounts
        secret: ThisIsAnExampleKeyForDevPurposeOnly
        redirectUris:
          - https://{{ $accounts }}/*
        webOrigins: []
        attributes:
          user.info.response.signature.alg: RS256
        optionalClientScopes:
          - given_name
          - usual_name
          - siret
  accounts:
    applications:
      - clientId: docs
        secret: ThisIsAnExampleKeyForDevPurposeOnly
        redirectUris:
          - https://{{ $docs }}/api/v1.0/callback/
        postLogoutRedirectUris:
          - https://{{ $docs }}/api/v1.0/logout-callback/
      - clientId: drive
        secret: ThisIsAnExampleKeyForDevPurposeOnly
        redirectUris:
          - https://{{ $drive }}/api/v1.0/callback/
        postLogoutRedirectUris:
          - https://{{ $drive }}/api/v1.0/logout-callback/
      - clientId: encryption
        secret: ThisIsAnExampleKeyForDevPurposeOnly
        redirectUris:
          - https://{{ $interface }}/auth/callback
        postLogoutRedirectUris: []

mailpit:
  host: {{ $f }}-mail.{{ $d }}
  ingress:
    className: {{ .Values.ingressClassName }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

onlyoffice:
  host: {{ $f }}-office.{{ $d }}
  ingress:
    className: {{ .Values.ingressClassName }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

driveRelay:
  image:
    repository: {{ $i.driveRelay.repository }}
    tag: {{ $driveTag | default $i.driveRelay.tag | quote }}
  host: {{ $drive }}
  driveApiUrl: https://{{ $drive }}
  ingress:
    className: {{ .Values.ingressClassName }}

encryption:
  image:
    repository: {{ $i.encryption.repository }}
    tag: {{ $i.encryption.tag | quote }}
  hosts:
    vault: {{ $vault }}
    interface: {{ $interface }}
  config:
    allowedFrameAncestors:
      - https://{{ $docs }}
      - https://{{ $drive }}
      - https://{{ $accounts }}
    oidc:
      issuer: {{ $issuer }}
    mailer:
      senderAddress: noreply@{{ $d }}
    emailProductUrl: https://{{ $docs }}
  ingress:
    className: {{ .Values.ingressClassName }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}

docs:
  image:
    repository: {{ $i.docs.repository }}
    tag: {{ $docsTag | default $i.docs.tag | quote }}
  backend:
    envVars:
      DJANGO_ALLOWED_HOSTS: {{ $docs }}
      DJANGO_CSRF_TRUSTED_ORIGINS: https://{{ $docs }}
      DJANGO_EMAIL_LOGO_IMG: https://{{ $docs }}/assets/logo-suite-numerique.png
      DJANGO_EMAIL_URL_APP: https://{{ $docs }}
      OIDC_OP_JWKS_ENDPOINT: {{ $issuer }}/.well-known/jwks.json
      OIDC_OP_AUTHORIZATION_ENDPOINT: {{ $issuer }}/authorize/
      OIDC_OP_TOKEN_ENDPOINT: {{ $issuer }}/token/
      OIDC_OP_USER_ENDPOINT: {{ $issuer }}/userinfo/
      OIDC_OP_LOGOUT_ENDPOINT: {{ $issuer }}/logout/
      OIDC_REDIRECT_ALLOWED_HOSTS: {{ $docs }}
      LOGIN_REDIRECT_URL: https://{{ $docs }}
      LOGIN_REDIRECT_URL_FAILURE: https://{{ $docs }}
      LOGOUT_REDIRECT_URL: https://{{ $docs }}
      ENCRYPTION_VAULT_URL: https://{{ $vault }}
      ENCRYPTION_INTERFACE_URL: https://{{ $interface }}
      ENCRYPTION_SETTINGS_URL: https://{{ $accounts }}/?section=encryption
  frontend:
    image:
      repository: {{ $i.docsFrontend.repository }}
      tag: {{ $docsTag | default $i.docsFrontend.tag | quote }}
    envVars:
      NEXT_PUBLIC_API_ORIGIN: https://{{ $docs }}
  yProvider:
    image:
      repository: {{ $i.docsYProvider.repository }}
      tag: {{ $docsTag | default $i.docsYProvider.tag | quote }}
    envVars:
      COLLABORATION_BACKEND_BASE_URL: https://{{ $docs }}
      COLLABORATION_SERVER_ORIGIN: https://{{ $docs }}
  ingress:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  ingressCollaborationWS:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
  ingressCollaborationApi:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
  ingressAdmin:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
  ingressMedia:
    className: {{ .Values.ingressClassName }}
    host: {{ $docs }}
    annotations:
      nginx.ingress.kubernetes.io/auth-url: https://{{ $docs }}/api/v1.0/documents/media-auth/
      nginx.ingress.kubernetes.io/upstream-vhost: minio:9000
  serviceMedia:
    host: {{ $minio }}

drive:
  image:
    repository: {{ $i.drive.repository }}
    tag: {{ $driveTag | default $i.drive.tag | quote }}
  backend:
    envVars:
      DJANGO_ALLOWED_HOSTS: {{ $drive }}
      DJANGO_CSRF_TRUSTED_ORIGINS: https://{{ $drive }}
      DJANGO_EMAIL_LOGO_IMG: https://{{ $drive }}/assets/logo-suite-numerique.png
      OIDC_OP_JWKS_ENDPOINT: {{ $issuer }}/.well-known/jwks.json
      OIDC_OP_AUTHORIZATION_ENDPOINT: {{ $issuer }}/authorize/
      OIDC_OP_TOKEN_ENDPOINT: {{ $issuer }}/token/
      OIDC_OP_USER_ENDPOINT: {{ $issuer }}/userinfo/
      OIDC_OP_LOGOUT_ENDPOINT: {{ $issuer }}/logout/
      LOGIN_REDIRECT_URL: https://{{ $drive }}
      LOGIN_REDIRECT_URL_FAILURE: https://{{ $drive }}
      LOGOUT_REDIRECT_URL: https://{{ $drive }}
      AWS_S3_ENDPOINT_URL: https://{{ $s3 }}
      MEDIA_BASE_URL: https://{{ $drive }}
      ENCRYPTION_VAULT_URL: https://{{ $vault }}
      ENCRYPTION_INTERFACE_URL: https://{{ $interface }}
      ENCRYPTION_SETTINGS_URL: https://{{ $accounts }}/?section=encryption
      WOPI_SRC_BASE_URL: https://{{ $drive }}
  frontend:
    image:
      repository: {{ $i.driveFrontend.repository }}
      tag: {{ $driveTag | default $i.driveFrontend.tag | quote }}
    envVars:
      NEXT_PUBLIC_API_ORIGIN: https://{{ $drive }}
  ingress:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  ingressAdmin:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
  ingressMedia:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
    annotations:
      nginx.ingress.kubernetes.io/auth-url: https://{{ $drive }}/api/v1.0/items/media-auth/
      nginx.ingress.kubernetes.io/upstream-vhost: {{ $s3 }}
  ingressMediaPreview:
    className: {{ .Values.ingressClassName }}
    host: {{ $drive }}
    annotations:
      nginx.ingress.kubernetes.io/auth-url: https://{{ $drive }}/api/v1.0/items/media-auth/
      nginx.ingress.kubernetes.io/upstream-vhost: {{ $s3 }}
  serviceMedia:
    host: {{ $minio }}

accounts:
  image:
    repository: {{ $i.accounts.repository }}
    tag: {{ $accountsTag | default $i.accounts.tag | quote }}
  backend:
    envVars:
      DJANGO_ALLOWED_HOSTS: {{ $accounts }}
      DJANGO_CSRF_TRUSTED_ORIGINS: https://{{ $accounts }}
      DJANGO_EMAIL_FROM: noreply@{{ $d }}
      FRONTEND_LOGOUT_URL: https://{{ $accounts }}/logout
      LOGIN_REDIRECT_URL: https://{{ $accounts }}
      LOGOUT_REDIRECT_URL: https://{{ $accounts }}
      MEDIA_BASE_URL: https://{{ $accounts }}
      OAUTH2_PROVIDER_OIDC_ISS_ENDPOINT: {{ $issuer }}
      SOCIAL_AUTH_ALLOWED_REDIRECT_HOSTS: {{ $accounts }}
      SOCIAL_AUTH_PRO_CONNECT_OIDC_ENDPOINT: {{ $keycloakIssuer }}
      ENCRYPTION_VAULT_URL: https://{{ $vault }}
      ENCRYPTION_INTERFACE_URL: https://{{ $interface }}
  frontend:
    image:
      repository: {{ $i.accountsFrontend.repository }}
      tag: {{ $accountsTag | default $i.accountsFrontend.tag | quote }}
    envVars:
      NEXT_PUBLIC_API_ORIGIN: https://{{ $accounts }}
  ingress:
    className: {{ .Values.ingressClassName }}
    host: {{ $accounts }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  ingressAdmin:
    className: {{ .Values.ingressClassName }}
    host: {{ $accounts }}
  serviceMedia:
    host: {{ $minio }}
