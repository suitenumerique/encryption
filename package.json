{
  "name": "encryption",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numerique-gouv/encryption.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -c \"auto\" \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:demo:product-a\" \"npm:dev:demo:product-b\" \"npm:dev:storybook\"",
    "dev:product": "concurrently --kill-others -c \"auto\" \"npm:dev:server:product\" \"npm:dev:client\"",
    "dev:client": "vite build --watch --config src/client/vite.config.ts",
    "dev:server": "dotenv-run-script .env.test -- dev:server:unsecure",
    "dev:server:product": "dotenv-run-script .env.test.product -- dev:server:unsecure",
    "dev:server:unsecure": "NODE_ENV=development tsx watch src/server/main.ts",
    "dev:demo:product-a": "DEMO_PORT=7201 vite --config src/demo/vite.config.ts",
    "dev:demo:product-b": "DEMO_PORT=7202 vite --config src/demo/vite.config.ts",
    "dev:storybook": "storybook dev -p 7204 --no-open",
    "build:storybook": "storybook build",
    "start:storybook": "serve -l 7204 --no-request-logging storybook-static",
    "build:prepare": "npm run db:schema:compile",
    "build": "concurrently --kill-others-on-fail -c \"auto\" \"npm:build:server\" \"npm:build:vault\" \"npm:build:ui\" \"npm:build:client\"",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node24 --outfile=dist/server/main.mjs --format=esm --sourcemap --metafile=dist/server/meta.json --alias:@encryption/src=./src --external:vite --external:@fastify/swagger --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && npm run build:server:sbom",
    "build:server:sbom": "cyclonedx-esbuild dist/server/meta.json --output-file dist/server/sbom.cdx.json && rm dist/server/meta.json",
    "build:vault": "vite build --config src/vault/vite.config.ts",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "build:client": "vite build --config src/client/vite.config.ts && cp dist/client/client.d.mts dist/client/client.d.ts",
    "start": "dotenv-run-script .env.test -- start:unsecure",
    "start:unsecure": "node dist/server/main.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:prepare": "npm run db:schema:compile",
    "lint": "npm run lint:es && npm run lint:ts",
    "lint:es": "TIMING=1 eslint .",
    "lint:ts": "tsc --noEmit --incremental false",
    "test:prepare": "npm run db:schema:compile",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:e2e": "vitest run --config vitest.storybook.config.ts",
    "test:e2e:headless": "vitest run --config vitest.storybook.config.ts --browser.headless",
    "db:schema:compile": "prisma generate",
    "db:push": "dotenv-run-script .env.test -- db:push:unsecure",
    "db:push:unsecure": "prisma db push",
    "db:seed": "dotenv-run-script .env.test -- db:seed:unsecure",
    "db:seed:unsecure": "prisma db seed",
    "db:migration:prepare": "dotenv-run-script .env.test -- db:migration:prepare:unsecure",
    "db:migration:prepare:unsecure": "prisma migrate dev",
    "db:migration:prepare:manually": "dotenv-run-script .env.test -- db:migration:prepare:manually:unsecure",
    "db:migration:prepare:manually:unsecure": "prisma migrate dev --create-only",
    "db:migration:deploy": "dotenv-run-script .env.test -- db:migration:deploy:unsecure",
    "db:migration:deploy:unsecure": "prisma migrate deploy",
    "db:studio": "dotenv-run-script .env.test -- db:studio:unsecure",
    "db:studio:unsecure": "prisma studio",
    "api:schema:sync": "npm run api:schema:generate && npm run api:client:generate",
    "api:schema:generate:unsecure": "tsx src/build/generate-openapi.ts && prettier --write --log-level warn openapi.json",
    "api:schema:generate": "dotenv-run-script .env.test -- api:schema:generate:unsecure",
    "api:client:generate": "openapi-ts",
    "ci:simulate": "act push --reuse --concurrent-jobs 1 --eventpath .github/act/event.json -P ubuntu-latest=catthehacker/ubuntu:act-latest",
    "clean": "rm -rf dist && rm -rf node_modules"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.script.ts"
  },
  "overrides": {
    "js-yaml@^4": "4.3.1",
    "@rolldown/plugin-babel": {
      "@babel/plugin-transform-runtime": "^7"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@lavamoat/preinstall-always-fail": false,
    "@prisma/engines": false,
    "@swc/core": false,
    "esbuild": false,
    "fsevents": false,
    "msw": false,
    "prisma": false
  },
  "dependencies": {
    "@faire/mjml-react": "4.0.1",
    "@fastify/middie": "9.3.3",
    "@fastify/static": "10.1.3",
    "@fontsource-variable/inter": "5.2.8",
    "@gouvfr-lasuite/cunningham-react": "4.2.0",
    "@mdx-js/react": "3.1.1",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@react-pdf/renderer": "4.5.1",
    "@scure/bip39": "2.4.0",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "highlight.js": "11.11.1",
    "html-to-text": "10.0.1",
    "i18next": "26.4.0",
    "i18next-browser-languagedetector": "8.2.1",
    "idb": "8.0.3",
    "jose": "6.2.1",
    "jsqr": "1.4.0",
    "libsodium-sumo": "0.8.4",
    "libsodium-wrappers-sumo": "0.8.4",
    "mermaid": "11.16.0",
    "mjml": "5.4.0",
    "nodemailer": "9.0.3",
    "oidc-client-ts": "3.5.0",
    "pg": "8.20.0",
    "qrcode": "1.5.4",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-i18next": "17.0.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-esbuild": "1.4.4",
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "10.0.1",
    "@fastify/swagger": "9.8.1",
    "@gouvfr-lasuite/ui-kit": "0.19.8",
    "@hey-api/openapi-ts": "0.99.0",
    "@lavamoat/preinstall-always-fail": "3.0.0",
    "@mdx-js/rollup": "3.1.1",
    "@microsoft/api-extractor": "7.59.0",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/html-to-text": "9.0.4",
    "@types/mjml": "5.0.0",
    "@types/mjml-browser": "5.0.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.18.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/trusted-types": "2.0.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "browserslist": "4.28.1",
    "concurrently": "10.0.5",
    "dotenv-run-script": "0.4.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "mjml-browser": "5.4.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "pglite-prisma-adapter": "0.7.2",
    "playwright": "1.61.1",
    "prettier": "3.8.1",
    "prisma": "7.5.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rollup-plugin-sbom": "4.0.0",
    "serve": "14.2.6",
    "storybook": "10.5.10",
    "storybook-dark-mode": "5.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-sri-gen": "1.3.2",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25.0.0",
    "npm": ">=12.0.0"
  }
}
