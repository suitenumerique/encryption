{
  "name": "encryption",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numerique-gouv/encryption.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -c \"auto\" \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:demo:product-a\" \"npm:dev:demo:product-b\" \"npm:dev:storybook\"",
    "dev:product": "concurrently --kill-others -c \"auto\" \"npm:dev:server:product\" \"npm:dev:client\"",
    "dev:client": "vite build --watch --config src/client/vite.config.ts",
    "dev:server": "dotenv-run-script .env.test -- dev:server:unsecure",
    "dev:server:product": "dotenv-run-script .env.test.product -- dev:server:unsecure",
    "dev:server:unsecure": "NODE_ENV=development tsx watch src/server/main.ts",
    "dev:demo:product-a": "DEMO_PORT=7201 vite --config src/demo/vite.config.ts",
    "dev:demo:product-b": "DEMO_PORT=7202 vite --config src/demo/vite.config.ts",
    "dev:storybook": "storybook dev -p 7204 --no-open",
    "build:storybook": "storybook build",
    "build": "concurrently --kill-others-on-fail -c \"auto\" \"npm:build:server\" \"npm:build:vault\" \"npm:build:ui\" \"npm:build:client\"",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node24 --outfile=dist/server/main.mjs --format=esm --sourcemap --alias:@encryption/src=./src --external:vite --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:vault": "vite build --config src/vault/vite.config.ts",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "build:client": "vite build --config src/client/vite.config.ts && cp dist/client/client.d.mts dist/client/client.d.ts",
    "start": "dotenv-run-script .env.test -- start:unsecure",
    "start:unsecure": "node dist/server/main.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:prepare": "npm run db:schema:compile",
    "lint": "npm run lint:es && npm run lint:ts",
    "lint:es": "TIMING=1 eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:ts": "tsc --noEmit --incremental false",
    "test:unit": "npm run jest --- --ci --passWithNoTests",
    "test:unit:watch": "npm run jest --- --watch",
    "jest": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "db:schema:compile": "prisma generate",
    "db:push": "dotenv-run-script .env.test -- db:push:unsecure",
    "db:push:unsecure": "prisma db push",
    "db:seed": "dotenv-run-script .env.test -- db:seed:unsecure",
    "db:seed:unsecure": "prisma db seed",
    "db:migration:prepare": "dotenv-run-script .env.test -- db:migration:prepare:unsecure",
    "db:migration:prepare:unsecure": "prisma migrate dev",
    "db:migration:prepare:manually": "dotenv-run-script .env.test -- db:migration:prepare:manually:unsecure",
    "db:migration:prepare:manually:unsecure": "prisma migrate dev --create-only",
    "db:migration:deploy": "dotenv-run-script .env.test -- db:migration:deploy:unsecure",
    "db:migration:deploy:unsecure": "prisma migrate deploy",
    "db:studio": "dotenv-run-script .env.test -- db:studio:unsecure",
    "db:studio:unsecure": "prisma studio",
    "clean": "rm -rf dist && rm -rf node_modules"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.script.ts"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "1.25.5",
    "@fastify/middie": "9.3.1",
    "@fastify/static": "8.3.0",
    "@gouvfr-lasuite/cunningham-react": "4.2.0",
    "@gouvfr-lasuite/ui-kit": "0.19.8",
    "@gouvfr/dsfr": "1.12.1",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@scure/bip39": "1.5.4",
    "browserslist": "4.28.1",
    "fastify": "5.8.2",
    "i18next": "25.8.19",
    "i18next-browser-languagedetector": "8.2.1",
    "idb": "8.0.3",
    "jose": "6.2.1",
    "jsqr": "1.4.0",
    "libsodium-sumo": "0.8.4",
    "libsodium-wrappers-sumo": "0.8.4",
    "oidc-client-ts": "^3.5.0",
    "pg": "8.20.0",
    "qrcode": "1.5.4",
    "react-i18next": "16.5.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-docs": "8.6.18",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.37",
    "@types/pg": "8.18.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.2.1",
    "dotenv-run-script": "0.4.1",
    "esbuild": "0.25.12",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "pglite-prisma-adapter": "0.7.2",
    "prettier": "3.8.1",
    "prisma": "7.5.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "storybook": "8.6.18",
    "storybook-dark-mode": "4.0.2",
    "ts-jest": "29.4.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-sri-gen": "1.3.2"
  },
  "packageManager": "npm@10.4.0",
  "engines": {
    "node": ">=24.14.0 <25.0.0"
  }
}
