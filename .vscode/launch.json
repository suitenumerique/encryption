{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: debug",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm run dev:server",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Vault: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "UI: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
