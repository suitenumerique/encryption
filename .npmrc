# --------------------------------------------------------------------------
# Supply chain policy. See plan.md (phase 0) for the reasoning behind each line.
# This file is committed on purpose: the policy has to apply to every machine
# that installs this project, not only to CI.
# --------------------------------------------------------------------------

# Never resolve a dependency from a git ref or an arbitrary tarball URL. Both are
# npm >= 12 defaults; stated explicitly so the intent survives a downgrade and so
# a reviewer does not have to know the default.
allow-git=none
allow-remote=none

# Do not install a version published less than 7 days ago. Most malicious npm
# versions are detected and unpublished within hours, so the delay turns the
# common case into a non-event. `npm ci` is unaffected: it installs the lockfile.
min-release-age=7

# `npm install <pkg>` writes an exact version, matching the repo convention that
# every dependency is pinned.
save-exact=true

# Refuse to install under a Node/npm version the project does not support. This
# is what guarantees npm >= 12 is in use, and therefore that the `allowScripts`
# policy in package.json is actually enforced.
engine-strict=true

fund=false

# Deliberately NOT set here: `ignore-scripts`. Install scripts are governed by the
# `allowScripts` field in package.json (npm >= 12), which is strictly better: it is
# reviewed, committed, and pinned per package VERSION, so a new version of an
# already-approved package is blocked again until someone re-approves it.
# `ignore-scripts=true` would override that policy and disable the approvals too.
